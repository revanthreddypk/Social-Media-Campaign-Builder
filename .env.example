# ---------------------------------------------------------------------------
# Copy this file to .env.local for local dev, or set these in Vercel's dashboard.
# The key is used ONLY server-side (in /api/generate) and never sent to browsers.
# ---------------------------------------------------------------------------

# Which provider you want to use: anthropic | openai | google | compatible
LLM_PROVIDER=anthropic

# Your API key for that provider.
LLM_API_KEY=your-key-here

# The model id for your provider. Defaults if left blank:
#   anthropic  -> claude-sonnet-5
#   openai     -> gpt-4o-mini
#   google     -> gemini-1.5-flash
#   compatible -> gpt-4o-mini
LLM_MODEL=

# ONLY for LLM_PROVIDER=compatible (OpenRouter, Groq, Together, a local server…)
# e.g. https://openrouter.ai/api/v1  or  https://api.groq.com/openai/v1
LLM_BASE_URL=
